;   param=value ; assign values to parameters

config_version=5

[application]

config/name="jogo-folclore"
run/main_scene="uid://bp13n7ri1i1a0"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

TransitionLendas="*uid://dg7mo1uj402yq"
DialogManager="*uid://b5wdy4i3boae2"
GameUtils="*uid://dv20ihkyp5piu"
Dialogic="*uid://b7ojma1gismy7"

[dialogic]

directories/dch_directory={
"bloco": "res://timelines/bloco.dch",
"blocointer": "res://timelines/blocointer.dch",
"curupira": "res://timelines/curupira.dch",
